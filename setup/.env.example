# Copy to setup/.env and fill in. setup.sh merges these into ~/.hermes/.env (yours win when non-empty).
# Never commit setup/.env.

# --- You ---
JARVIS_OWNER_NAME=              # what Jarvis calls you on voice calls (also helps speech-to-text hear it)

# --- Telegram (required) ---  bot token from @BotFather; your numeric id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=         # your numeric id; the first id is the owner (the only one who may call)
TELEGRAM_HOME_CHANNEL=          # same numeric id as above; where cron results and alerts land

# --- Vault (long-term memory) ---  an existing Obsidian vault, or leave it: setup.sh creates a starter vault there
OBSIDIAN_VAULT_PATH=$HOME/jarvis-vault
VAULT_GIT_URL=                  # private git remote of the vault (ssh form). Empty = no clone, no sync.

# --- Model (required) ---  MODEL_AUTH=claude  -> Claude Pro/Max subscription via the Claude Code CLI login (setup.sh installs it and prompts you)
#                           MODEL_AUTH=api     -> Anthropic API key, pay per token (fill ANTHROPIC_API_KEY)
MODEL_AUTH=claude
ANTHROPIC_API_KEY=
JARVIS_MODEL=                   # empty = default: "sonnet" (claude) or "claude-sonnet-5" (api). Change later: hermes model

# --- Voice calls over Telegram (optional) ---  a separate Telegram *user* account for Jarvis (spare number).
# api_id / api_hash from https://my.telegram.org -> API development tools. Login is interactive once (setup.sh prints how).
# Leave empty to skip voice.
TELEGRAM_CALL_API_ID=
TELEGRAM_CALL_API_HASH=

# --- GUI control (optional, experimental) ---  GNOME on Wayland only. 1 = install the gui skill.
JARVIS_GUI=
